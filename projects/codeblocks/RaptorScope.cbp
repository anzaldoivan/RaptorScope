<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="RaptorScope" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../../bin/Debug/RaptorScope" prefix_auto="0" extension_auto="1" />
				<Option object_output="../../build/codeblocks/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D_DEBUG" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="../../bin/Release/RaptorScope" prefix_auto="0" extension_auto="1" />
				<Option object_output="../../build/codeblocks/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DNDEBUG" />
				</Compiler>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-Wextra" />
			<Add option="-DWINVER=0x0501" />
			<Add option="-D_WIN32_WINNT=0x0501" />
			<Add directory="../../include" />
		</Compiler>
		<Linker>
			<Add option="-mwindows" />
			<Add library="comctl32" />
			<Add library="gdi32" />
			<Add library="opengl32" />
			<Add library="glu32" />
			<Add library="winmm" />
			<Add library="comdlg32" />
			<Add library="ole32" />
			<Add library="advapi32" />
			<Add library="msimg32" />
			<Add library="shell32" />
		</Linker>
		<Unit filename="../../include/core/audio.h" />
		<Unit filename="../../include/core/color.h" />
		<Unit filename="../../include/core/lzss.h" />
		<Unit filename="../../include/core/types.h" />
		<Unit filename="../../include/ext/pl_mpeg.h" />
		<Unit filename="../../include/formats/dat.h" />
		<Unit filename="../../include/formats/mesh.h" />
		<Unit filename="../../include/formats/save_editor.h" />
		<Unit filename="../../include/formats/scd.h" />
		<Unit filename="../../include/formats/dc2.h" />
		<Unit filename="../../include/formats/texture.h" />
		<Unit filename="../../include/formats/tim.h" />
		<Unit filename="../../include/ui/app.h" />
		<Unit filename="../../include/ui/panels.h" />
		<Unit filename="../../include/ui/about_banner.h" />
		<Unit filename="../../include/ui/about_dialog.h" />
		<Unit filename="../../res/RaptorScope.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="../../src/core/audio.cpp" />
		<Unit filename="../../src/core/color.cpp" />
		<Unit filename="../../src/core/lzss.cpp" />
		<Unit filename="../../src/formats/dat.cpp" />
		<Unit filename="../../src/formats/mesh.cpp" />
		<Unit filename="../../src/formats/save_editor.cpp" />
		<Unit filename="../../src/formats/scd.cpp" />
		<Unit filename="../../src/formats/dc2_room.cpp" />
		<Unit filename="../../src/formats/dc2_scd.cpp" />
		<Unit filename="../../src/formats/dc2_model.cpp" />
		<Unit filename="../../src/formats/texture.cpp" />
		<Unit filename="../../src/formats/tim.cpp" />
		<Unit filename="../../src/formats/video.cpp" />
		<Unit filename="../../src/main.cpp" />
