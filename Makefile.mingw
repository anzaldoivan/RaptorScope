#═══════════════════════════════════════════════════════════════════
#  RaptorScope — MinGW Makefile
#  Build:  mingw32-make -f Makefile.mingw
#  Clean:  mingw32-make -f Makefile.mingw clean
#═══════════════════════════════════════════════════════════════════

CC      = g++
WINDRES = windres

# The upstream UI uses lambdas and aggregate initialization.
CFLAGS  = -std=c++11 -Wall -Wextra -O2 \
          -Iinclude \
          -DWINVER=0x0501 -D_WIN32_WINNT=0x0501 \
          -MMD -MP

LDFLAGS = -mwindows \
          -lcomctl32 -lgdi32 -lopengl32 -lglu32 \
          -lwinmm -lcomdlg32 -lole32 -loleaut32 -luuid -ladvapi32 \
          -lmsimg32 -lshell32

# Debug build
ifdef DEBUG
CFLAGS  += -g -O0 -D_DEBUG
OUTDIR  = bin/Debug
OBJDIR  = build/debug
else
CFLAGS  += -O2 -DNDEBUG
OUTDIR  = bin/Release
OBJDIR  = build/release
endif

TARGET = $(OUTDIR)/RaptorScope.exe

#─── Sources ─────────────────────────────────────────────────────
SRCS = src/main.cpp \
       src/core/lzss.cpp \
       src/core/color.cpp \
       src/core/audio.cpp \
       src/formats/dat.cpp \
       src/formats/texture.cpp \
       src/formats/mesh.cpp \
       src/formats/tim.cpp \
       src/formats/video.cpp \
       src/formats/save_editor.cpp \
       src/formats/scd.cpp \
       src/formats/dc2_room.cpp \
       src/formats/dc2_scd.cpp \
       src/formats/dc2_model.cpp \
       src/ui/app.cpp \
       src/ui/panels.cpp

OBJS = $(patsubst src/%.cpp,$(OBJDIR)/%.o,$(SRCS))
RES  = $(OBJDIR)/resources.o

#─── Rules ───────────────────────────────────────────────────────
all: dirs $(TARGET)

dirs:
	@if not exist "$(OUTDIR)" mkdir "$(OUTDIR)"
	@if not exist "$(OBJDIR)" mkdir "$(OBJDIR)"
	@if not exist "$(OBJDIR)\core" mkdir "$(OBJDIR)\core"
	@if not exist "$(OBJDIR)\formats" mkdir "$(OBJDIR)\formats"
	@if not exist "$(OBJDIR)\ui" mkdir "$(OBJDIR)\ui"

$(TARGET): $(OBJS) $(RES)
	$(CC) -o $@ $^ $(LDFLAGS)
	@echo === Build complete: $@ ===

$(OBJDIR)/%.o: src/%.cpp
	$(CC) $(CFLAGS) -c $< -o $@

$(RES): res/RaptorScope.rc res/xp_style.manifest res/vban.bin
	$(WINDRES) -i res/RaptorScope.rc -o $@ --include-dir=res

clean:
	@if exist "$(OBJDIR)" rmdir /s /q "$(OBJDIR)"
	@if exist "$(TARGET)" del "$(TARGET)"

# Include auto-generated header dependencies
DEPS = $(OBJS:.o=.d)
-include $(DEPS)

.PHONY: all dirs clean
